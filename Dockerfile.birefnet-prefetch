# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
RUN python -m pip install --no-cache-dir 'runpod==1.8.1'

COPY <<'PY' /app/stage_birefnet.py
import ast
import shutil
import tempfile
from pathlib import Path

import runpod

VOLUME = Path("/runpod-volume")
ROOT = VOLUME / "clay" / "trellis2-cache"
BIREFNET = Path("models--ZhengPeng7--BiRefNet/snapshots/66f7f80c1a64b3c4df327a07eeca4e87130b787b")
SPARSE = Path("models--microsoft--TRELLIS-image-large/snapshots/25e0d31ffbebe4b5a97464dd851910efc3002d96")


def fixed_birefnet(source):
    tree = ast.parse(source)
    config = next(cls for cls in tree.body if isinstance(cls, ast.ClassDef) and cls.name == "Config")
    init = next(method for method in config.body if isinstance(method, ast.FunctionDef) and method.name == "__init__")
    lines = source.splitlines(keepends=True)
    body = init.body[0]
    if any(line.strip() == "super().__init__()" for line in lines[init.lineno: init.end_lineno]):
        return source
    # BiRefNet's Config subclasses PretrainedConfig. Call its omitted initializer
    # as in upstream https://huggingface.co/ZhengPeng7/BiRefNet/discussions/18.
    lines.insert(body.lineno - 1, " " * body.col_offset + "super().__init__()\n")
    result = "".join(lines)
    compile(result, "birefnet.py", "exec")
    return result


def link_weight(source, target):
    size = source.stat().st_size
    if target.exists() and target.stat().st_size == size:
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=target.parent) as scratch:
        entry = Path(scratch) / target.name
        try:
            entry.symlink_to(source)
            if entry.stat().st_size != size:
                raise OSError("The volume did not resolve the symlink")
        except OSError:
            entry.unlink(missing_ok=True)
            shutil.copyfile(source, entry)
        entry.replace(target)
    if not target.is_file() or target.stat().st_size != size:
        raise RuntimeError(f"Cached file is incomplete: {target.name}")


def handler(job):
    if job.get("input") != {"operation": "stage_clay_birefnet_compat"}:
        return {"error": "Expected stage_clay_birefnet_compat operation"}
    if not VOLUME.is_mount():
        raise RuntimeError("The approved Global Volume is not mounted")
    original = ROOT / "hub"
    compat = ROOT / "compat-hub"
    patch_path = BIREFNET / "birefnet.py"
    patch = fixed_birefnet((original / patch_path).read_text())
    for filename in ("config.json", "BiRefNet_config.py", "model.safetensors"):
        link_weight(original / BIREFNET / filename, compat / BIREFNET / filename)
    for suffix in (".json", ".safetensors"):
        name = SPARSE / "ckpts" / f"ss_dec_conv3d_16l8_fp16{suffix}"
        link_weight(original / name, compat / name)
    fixed = compat / patch_path
    with tempfile.NamedTemporaryFile("w", dir=fixed.parent, delete=False) as out:
        out.write(patch)
        temporary = Path(out.name)
    try:
        temporary.replace(fixed)
    finally:
        temporary.unlink(missing_ok=True)
    if fixed.read_text() != patch:
        raise RuntimeError("The patched file did not persist to the volume")
    return {"status": "ready", "checkpoint_linked": (compat / BIREFNET / "model.safetensors").is_symlink()}


runpod.serverless.start({"handler": handler})
PY

CMD ["python", "-u", "/app/stage_birefnet.py"]
