FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends blender ca-certificates python3-numpy \
    && rm -rf /var/lib/apt/lists/*
RUN blender --background --factory-startup --python-exit-code 1 --python-expr 'import numpy'
RUN pip install --no-cache-dir runpod==1.8.1 pillow httpx

WORKDIR /app
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1
COPY src/clay/__init__.py src/clay/pbr_bake.py /app/src/clay/
COPY src/clay/blender /app/src/clay/blender/
COPY rp_bake_handler.py /app/

CMD ["python", "-u", "rp_bake_handler.py"]
