FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_DOWNLOAD_TIMEOUT=60 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app
RUN python -m pip install --no-cache-dir 'runpod==1.8.1' 'huggingface_hub==0.36.2'
COPY rp_prefetch.py /app/rp_prefetch.py
CMD ["python", "-u", "/app/rp_prefetch.py"]
